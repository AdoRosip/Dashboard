DATABASE_URL="file:./dev.db"
# Required for npm run ingest / daily — fixtures, scores, standings (football-data.org).
FOOTBALL_DATA_API_KEY="your-football-data-org-api-key"
# Optional — NOT used by ingest today (no code calls fetchApiFootball). Only for npm run api-football:ping or future wiring.
API_FOOTBALL_KEY="your-rapidapi-key-for-api-football"
# Optional — The Odds API: upcoming odds snapshots + value-pick lines. When unset, odds refresh skips network calls.
ODDS_API_KEY=""
# Bearer token required for mutating API routes (refresh, odds, settle, admin, calibration, research).
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_API_TOKEN=""
# Ingest / daily tuning (see README §8).
# AHEAD_DAYS=
# RESULTS_DAYS=7
# SKIP_UNDERSTAT=false
# Understat scraper may read season from env when set:
# CURRENT_SEASON=2025
